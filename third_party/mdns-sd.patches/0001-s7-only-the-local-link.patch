+/// Counts legacy-unicast responses per destination address, for
+/// [`UNICAST_REPLIES_PER_ADDR_PER_SEC`].
+#[derive(Default)]
+struct UnicastReplyLimiter {
+    /// Per address: when its current one-second window began (UNIX millis),
+    /// and how many responses went to it since.
+    sent: HashMap<IpAddr, (u64, u32)>,
+}
+
+impl UnicastReplyLimiter {
+    /// Whether one more response may go to `ip` at `now`; counts it if so.
+    fn allow(&mut self, ip: IpAddr, now: u64) -> bool {
+        const WINDOW_MILLIS: u64 = 1000;
+        if !self.sent.contains_key(&ip) && self.sent.len() >= UNICAST_REPLY_ADDRS_MAX {
+            self.sent
+                .retain(|_, (start, _)| now < start.saturating_add(WINDOW_MILLIS));
+            if self.sent.len() >= UNICAST_REPLY_ADDRS_MAX {
+                return false;
+            }
+        }
+        let (start, count) = self.sent.entry(ip).or_insert((now, 0));
+        if now >= start.saturating_add(WINDOW_MILLIS) {
+            *start = now;
+            *count = 0;
+        }
+        if *count >= UNICAST_REPLIES_PER_ADDR_PER_SEC {
+            return false;
+        }
+        *count += 1;
+        true
+    }
+}
