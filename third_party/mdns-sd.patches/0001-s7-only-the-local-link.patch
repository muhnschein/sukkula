+/// Whether `ip` is on the local link of `intf`: link-local, or on the subnet
+/// of one of the interface's addresses (RFC 6762 §5.5, §11).
+fn is_on_link(ip: &IpAddr, intf: &MyIntf) -> bool {
+    let link_local = match ip {
+        IpAddr::V4(v4) => v4.is_link_local(),
+        IpAddr::V6(v6) => (v6.segments()[0] & 0xffc0) == 0xfe80,
+    };
+    link_local || intf.addrs.iter().any(|a| valid_ip_on_intf(ip, a))
+}
