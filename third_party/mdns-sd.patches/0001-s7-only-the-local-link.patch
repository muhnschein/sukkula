+/// A predicate on the source address of a received packet, for
+/// [`ServiceDaemon::new_with_source_filter`].
+#[derive(Clone)]
+pub struct SourcePredicate(std::sync::Arc<dyn Fn(&IpAddr) -> bool + Send + Sync>);
+
+impl SourcePredicate {
+    /// Creates a predicate from a closure that decides whether packets from
+    /// an address are read.
+    ///
+    /// # Example
+    ///
+    /// ```no_run
+    /// # use mdns_sd::SourcePredicate;
+    /// // Only private IPv4 peers.
+    /// SourcePredicate::new(|ip| match ip {
+    ///     std::net::IpAddr::V4(v4) => v4.is_private(),
+    ///     std::net::IpAddr::V6(_) => false,
+    /// });
+    /// ```
+    pub fn new(predicate: impl Fn(&IpAddr) -> bool + Send + Sync + 'static) -> Self {
+        Self(std::sync::Arc::new(predicate))
+    }
+
+    pub(crate) fn matches(&self, ip: &IpAddr) -> bool {
+        self.0(ip)
+    }
+}
+
+impl std::fmt::Debug for SourcePredicate {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "SourcePredicate(...)")
+    }
+}
