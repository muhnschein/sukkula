+        // ... a unique one takes the oldest one's place.
+        let new = txt(51, CLASS_IN | CLASS_CACHE_FLUSH);
+        assert!(cache
+            .add_or_update(&intf(), new, &mut timers, true, src(1), &mut room)
+            .is_some());
