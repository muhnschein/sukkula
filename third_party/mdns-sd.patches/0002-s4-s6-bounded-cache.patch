+        self.addr
+            .retain(|host, _| hosts.contains(host) || is_resolving(host));
+        self.nsec.retain(|name, _| {
+            let lower = name.to_lowercase();
+            instances.contains(name) || hosts.contains(&lower) || is_resolving(&lower)
+        });
+    }
