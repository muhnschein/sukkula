-pub fn peek_client_introduction(buf: &[u8]) -> Option<String> {
-    use location_nearby_connections::bandwidth_upgrade_negotiation_frame::EventType;
-    if buf.len() < 4 {
-        return None;
-    }
-    let len = u32::from_be_bytes([buf[0], buf[1], buf[2], buf[3]]) as usize;
