-        let byte = (v & 0x7f) as u8;
-        v >>= 7;
-        if v != 0 {
-            varint.push(byte | 0x80);
-        } else {
-            varint.push(byte);
-            break;
-        }
-    }
-    let sub_len = 5 + 1 + varint.len();
-    let mut msg = vec![
-        0u8,
-        0,
-        0,
-        0x08,
-        SOCKET_CTRL_PACKET_ACK,
-        0x22,
-        sub_len as u8,
-        0x0a,
-        0x03,
