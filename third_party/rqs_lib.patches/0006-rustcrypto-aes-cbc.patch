+        assert!(aes_cbc_decrypt(&key, &iv[..15], &ct).is_err());
+        assert!(aes_cbc_decrypt(&key[..16], &iv, &ct).is_err(), "short key");
+        assert!(
+            aes_cbc_decrypt(&key, &iv, &ct[..15]).is_err(),
+            "not whole blocks"
+        );
+        assert!(
+            aes_cbc_decrypt(&[8u8; 32], &iv, &ct).is_err(),
+            "wrong key: bad padding"
+        );
