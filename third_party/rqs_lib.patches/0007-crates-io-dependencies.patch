+        daemon.disable_interface(IfKind::IPv6)?;
+
         Ok(Self {
-            daemon: ServiceDaemon::new()?,
+            daemon,
             service_info,
             visibility_sender,
             visibility_receiver,
@@ -129,7 +134,7 @@ impl MDnsServer {
             service_port,
             &properties[..],
         )?
-        .enable_addr_auto(AddrType::V4);
+        .enable_addr_auto();
 
         Ok(si)
     }
