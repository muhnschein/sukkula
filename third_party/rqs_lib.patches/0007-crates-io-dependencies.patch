 use tokio_util::sync::CancellationToken;
@@ -47,8 +47,13 @@ impl MDnsServer {
     ) -> Result<Self, anyhow::Error> {
         let service_info = Self::build_service(endpoint_id, service_port, DeviceType::Laptop)?;
 
+        let daemon = ServiceDaemon::new()?;
