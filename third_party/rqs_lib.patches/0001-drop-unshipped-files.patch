-            continue;
-        };
-        if let Some(t) = target {
-            if addr != t {
-                continue;
-            }
-        }
-        let Ok(dev) = adapter.device(addr) else {
-            continue;
-        };
-        let Ok(Some(sd)) = dev.service_data().await else {
-            continue;
-        };
-        let Some(bytes) = sd.get(&Uuid::from_u16(0xFEF3)) else {
-            continue;
-        };
