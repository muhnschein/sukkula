-
-    let target: Option<Address> = match std::env::args().nth(1) {
-        Some(s) => Some(s.parse()?),
-        None => None,
-    };
-    let scan_secs: u64 = std::env::var("PROBE_SCAN_SECS")
-        .ok()
-        .and_then(|v| v.parse().ok())
-        .unwrap_or(30);
-
-    adapter
-        .set_discovery_filter(DiscoveryFilter {
-            transport: DiscoveryTransport::Le,
-            duplicate_data: true,
-            ..Default::default()
