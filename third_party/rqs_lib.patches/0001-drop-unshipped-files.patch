-    let mediums: Vec<i32> = std::env::var("PACKET_SEND_MEDIUMS")
-        .ok()
-        .map(|s| s.split(',').filter_map(|x| x.trim().parse().ok()).collect())
-        .unwrap_or_else(|| vec![5, 10]);
-
-    let session = bluer::Session::new().await?;
