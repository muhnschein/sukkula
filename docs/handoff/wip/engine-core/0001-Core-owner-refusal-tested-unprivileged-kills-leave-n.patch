+#[allow(clippy::disallowed_methods)]
+pub(crate) fn open_existing_at(
+    parent: &OwnedFd,
+    name: &str,
+    share: Share,
+) -> Result<Option<OwnedFd>, DirError> {
+    match rustix::fs::openat(parent, name, DIR_FLAGS, Mode::empty()) {
+        Ok(fd) => check(fd, share).map(Some),
