From: Claude <noreply@anthropic.com>
Date: Fri, 25 Sep 2026 09:30:10 +0000
Subject: [PATCH 5/9] WIP: leave the Quick Share D-Bus call sites to their
 owner

The integrator has the quickshare-mdns agent lift the open_private ban
at quickshare/ble.rs and tests/quickshare_ble.rs; the bans stay in.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ENZSCiAud5Vs29ugEacpyR
---
 crates/sukkula-engine/src/quickshare/ble.rs   | 4 ----
 crates/sukkula-engine/tests/quickshare_ble.rs | 4 ----
 2 files changed, 8 deletions(-)

diff --git a/crates/sukkula-engine/src/quickshare/ble.rs b/crates/sukkula-engine/src/quickshare/ble.rs
index 875d175..a4ea2ae 100644
--- a/crates/sukkula-engine/src/quickshare/ble.rs
+++ b/crates/sukkula-engine/src/quickshare/ble.rs
@@ -151,10 +151,6 @@ pub(super) fn spawn(address: Option<String>, token: CancellationToken) -> JoinHa
 /// Why it could not advertise, or stopped.
 pub fn advertise(address: &str, token: &CancellationToken) -> Result<(), NudgeError> {
     check_address(address)?;
-    // CONTRACT: clippy.toml bans every dbus-crate constructor (S8: libdbus
-    // runs `autolaunch:` and `unixexec:` addresses); lifted here alone,
-    // behind the check above.
-    #[allow(clippy::disallowed_methods)]
     let channel = Channel::open_private(address).map_err(|_| NudgeError::Unreachable)?;
     let mut nudge = Nudge {
         channel,
diff --git a/crates/sukkula-engine/tests/quickshare_ble.rs b/crates/sukkula-engine/tests/quickshare_ble.rs
index 27656d7..210c87f 100644
--- a/crates/sukkula-engine/tests/quickshare_ble.rs
+++ b/crates/sukkula-engine/tests/quickshare_ble.rs
@@ -107,10 +107,6 @@ impl Drop for Daemon {
     }
 }
 
-// CONTRACT: S8 bans libdbus's connection constructors outside the checked
-// ones (clippy.toml); the fake connects to the test's own daemon, at an
-// address it made.
-#[allow(clippy::disallowed_methods)]
 fn connect(address: &str, name: &str) -> Channel {
     let mut ch = Channel::open_private(address).unwrap();
     ch.register().unwrap();
