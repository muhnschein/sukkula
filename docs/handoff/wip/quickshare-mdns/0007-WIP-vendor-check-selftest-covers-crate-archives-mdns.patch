---
 ci/vendor-check-selftest.sh         | 42 ++++++++++++++++--
 fuzz/Cargo.lock                     |  2 -
 third_party/mdns-sd.patches/test.sh | 66 +++++++++++++++++++++++++++++
 3 files changed, 105 insertions(+), 5 deletions(-)
