+        return Ok(None);
+    };
+    cache
+        .iter()
+        .filter(|(_, r)| evict_from.contains(&r.source))
+        .min_by_key(|(_, r)| r.seq)
+        .map(|(name, _)| Some(name.clone()))
+        .ok_or(())
 }
 
