+        let (mut cache, mut seq) = (HashMap::new(), 0);
+        let sources = MAX_DISCOVERED_ENDPOINTS / MAX_ENDPOINTS_PER_SOURCE;
+        for s in 0..sources {
+            for i in 0..MAX_ENDPOINTS_PER_SOURCE {
+                assert!(add(&mut cache, &mut seq, &format!("s{s}i{i}"), src(s)));
+            }
+        }
