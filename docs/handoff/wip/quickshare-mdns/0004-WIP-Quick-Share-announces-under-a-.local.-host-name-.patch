++            wire::ptr(SERVICE_TYPE, &instance, ttl),
++            wire::srv(&instance, &host, 4000, ttl),
++            wire::txt(&instance, &n, ttl),
++            wire::a(&host, at, ttl),
++        ]));
++    }
++}
