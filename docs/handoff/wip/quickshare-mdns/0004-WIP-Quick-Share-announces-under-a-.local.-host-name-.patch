+    fn add(cache: &mut HashMap<String, Remembered>, seq: &mut u64, name: &str, source: Option<IpAddr>) -> bool {
+        match make_room(cache, source) {
+            Err(()) => return false,
+            Ok(Some(old)) => {
+                cache.remove(&old);
+            }
+            Ok(None) => {}
+        }
