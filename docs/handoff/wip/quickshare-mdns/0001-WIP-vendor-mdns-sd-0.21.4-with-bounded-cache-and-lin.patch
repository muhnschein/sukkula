+}
+
+impl DnsPointer {
+    pub fn new(name: &str, ty: RRType, class: u16, ttl: u32, alias: String) -> Self {
+        let record = DnsRecord::new(name, ty, class, ttl);
+        Self { record, alias }
+    }
+
+    pub fn alias(&self) -> &str {
+        &self.alias
+    }
