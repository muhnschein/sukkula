+/// Which records of a response are for us: those that answer something
+/// asked. A PTR record of a browsed type; an SRV or TXT record of an
+/// instance such a PTR record points to; an address record of a host such
+/// an SRV record names, or of a host being resolved; an NSEC record of any
+/// of these. Worked out once per response, lazily, as its records come in
+/// that order.
+#[derive(Default)]
+struct Wanted {
+    instances: Option<HashSet<String>>,
+    hosts: Option<HashSet<String>>,
+}
+
+impl Wanted {
+    fn wants(&mut self, zc: &Zeroconf, record: &DnsRecordBox) -> bool {
+        let name = record.get_name();
+        match record.get_type() {
+            RRType::PTR => zc.service_queriers.contains_key(name),
+            RRType::SRV | RRType::TXT => self.instances(zc).contains(name),
+            RRType::A | RRType::AAAA => {
+                let host = name.to_lowercase();
+                zc.hostname_resolvers.contains_key(&host) || self.hosts(zc).contains(&host)
+            }
+            RRType::NSEC => {
+                let host = name.to_lowercase();
+                self.instances(zc).contains(name)
+                    || zc.hostname_resolvers.contains_key(&host)
+                    || self.hosts(zc).contains(&host)
+            }
+            _ => false,
+        }
+    }
+
+    /// The instances of the browsed types.
+    fn instances(&mut self, zc: &Zeroconf) -> &HashSet<String> {
+        self.instances.get_or_insert_with(|| {
+            zc.service_queriers
+                .keys()
+                .filter_map(|ty| zc.cache.get_ptr(ty))
+                .flatten()
+                .filter_map(|r| r.record.any().downcast_ref::<DnsPointer>())
+                .map(|ptr| ptr.alias().to_string())
+                .collect()
+        })
+    }
+
+    /// The hosts, in lowercase, of the instances of the browsed types.
+    fn hosts(&mut self, zc: &Zeroconf) -> &HashSet<String> {
+        if self.hosts.is_none() {
+            let hosts = zc.cache.host_names(self.instances(zc));
+            self.hosts = Some(hosts);
+        }
+        self.hosts.get_or_insert_with(HashSet::new)
+    }
+}
