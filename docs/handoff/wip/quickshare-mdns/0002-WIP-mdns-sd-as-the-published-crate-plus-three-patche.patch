+    fn wifi() -> MyIntf {
+        MyIntf {
+            name: "wlan0".to_string(),
+            index: 3,
+            addrs: HashSet::from([IfAddr::V4(Ifv4Addr {
+                ip: Ipv4Addr::new(192, 168, 1, 10),
+                netmask: Ipv4Addr::new(255, 255, 255, 0),
+                broadcast: None,
+                prefixlen: 24,
