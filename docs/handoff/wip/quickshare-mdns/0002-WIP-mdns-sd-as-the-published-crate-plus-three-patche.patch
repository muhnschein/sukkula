+        );
+        let expiry = cache.next_deadline(refresh).unwrap();
+        assert!(
+            (created + 9_990..=created + 10_010).contains(&expiry),
+            "{expiry}"
+        );
+        // Past both, the long record's refresh is next, not a deadline gone by.
+        let next = cache.next_deadline(expiry).unwrap();
